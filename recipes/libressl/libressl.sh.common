rsv="${rver%.*}"
rsv="${rsv//./}"
rsn="${rname%${rsv}}"
rdir="${rsn}-${rver}"
rfile="${rdir}.tar.gz"
rurl="https://cdn.openbsd.org/pub/OpenBSD/LibreSSL/${rfile}"
rreqs="bootstrapmake cacertificates configgit"
rprof="${cwetcprofd}/zz_${rname}.sh"

. "${cwrecipe}/common.sh"

eval "
function cwconfigure_${rname}() {
  pushd \"\$(cwbdir_${rname})\" &>/dev/null
  ./configure ${cwconfigureprefix} ${cwconfigurelibopts} ${rconfigureopts} ${rcommonopts} \
    --disable-asm \
    --enable-nc \
    --with-openssldir=\"${cwetc}/libressl\" \
    --with-pic \
      CC=\"\${CC} -Os\" \
      CFLAGS=\"-Os \${CFLAGS}\" \
      LDFLAGS=-static \
      CPPFLAGS= \
      PKG_CONFIG_{LIBDIR,PATH}=
  popd &>/dev/null
}
"

eval "
function cwmakeinstall_${rname}() {
  pushd \"\$(cwbdir_${rname})\" &>/dev/null
  rm -f \"\$(cwidir_${rname})/bin/openssl\" \"\$(cwidir_${rname})/bin/${rsn}\"
  make install ${rlibtool}
  mv \"\$(cwidir_${rname})/bin/openssl\" \"\$(cwidir_${rname})/bin/${rsn}\"
  ln -sf \"${rtdir}/current/bin/${rsn}\" \"\$(cwidir_${rname})/bin/openssl\"
  ln -sf \"${rtdir}/current/bin/nc\" \"\$(cwidir_${rname})/bin/${rsn}-nc\"
  ln -sf \"${rtdir}/current/bin/${rsn}\" \"\$(cwidir_${rname})/bin/${rname}\"
  cwmkdir \"${cwetc}/ca-certs/${rname}\"
  cwmkdir \"\$(cwidir_${rname})/etc\"
  rm -f \"${cwetc}/ca-certs/${rname}/cert.pem\" || true
  rm -f \"\$(cwidir_${rname})/etc/cert.pem\" || true
  install -D -m 0644 \"\$(realpath cert.pem)\" \"${cwetc}/ca-certs/${rname}/cert.pem\"
  install -D -m 0644 \"\$(realpath cert.pem)\" \"\$(cwidir_${rname})/etc/cert.pem\"
  popd &>/dev/null
}
"

eval "
function cwgenprofd_${rname}() {
  echo 'append_path \"${cwsw}/openssl/current/bin\"' > \"${rprof}\"
  echo 'append_path \"${rtdir}/current/bin\"' >> \"${rprof}\"
}
"

unset rsv
unset rsn

# vim: ft=bash
